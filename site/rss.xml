---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0"><channel><title>{{ site.title | xml_escape }}</title><link>{{ site.url }}/</link><description>{{ site.description | xml_escape }}</description><language>zh-CN</language>
{% for note in site.data.notes %}<item><title>{{ note.title | xml_escape }}</title><link>{{ site.url }}{{ note.url }}</link><guid isPermaLink="true">{{ site.url }}{{ note.url }}</guid><description>{{ note.summary | xml_escape }}</description><pubDate>{{ note.updated | date_to_rfc822 }}</pubDate></item>{% endfor %}
</channel></rss>
